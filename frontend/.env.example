# Copy to .env.local for local development. Never commit real secrets.
#
# Server-only values used by Next.js route handlers.
# Do not put SECRET_KEY, NEBIUS_API_KEY, or other backend secrets here.

# FastAPI base URL (no trailing slash).
API_URL=http://127.0.0.1:8000

# Cookie lifetime in hours — keep aligned with backend JWT_EXPIRE_HOURS (default 72).
AUTH_COOKIE_MAX_AGE_HOURS=72
