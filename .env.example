# Copy to .env and fill in. Never commit the real .env.
#
# Docs:
#   API intro: https://docs.tokenfactory.nebius.com/api-reference/introduction
#   Model catalog: https://tokenfactory.nebius.com/model-catalog.md
#   Get a key: https://tokenfactory.nebius.com/ (API keys section)

NEBIUS_API_KEY=your-key-here

# OpenAI-compatible inference base URL (trailing /v1/ as in Nebius docs).
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Set to a Nemotron model id from the Nebius Token Factory catalog.
# Example from the public catalog (us-central1):
#   nvidia/nemotron-3-super-120b-a12b
# Confirm availability in the catalog or GET {NEBIUS_BASE_URL}models before use.
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional: request timeout in seconds (default 60).
# NEMOTRON_TIMEOUT_SECONDS=60

# --- Profile / wardrobe persistence ---
# SQLite file path (created automatically). Survives app restarts.
DATABASE_URL=sqlite:///./data/vastra.db

# JWT signing secret — change this for any shared/deployed environment.
SECRET_KEY=change-me-to-a-long-random-string-32b+

# Optional API bind + Streamlit client target (defaults shown).
# API_HOST=127.0.0.1
# API_PORT=8000
# VASTRA_API_URL=http://127.0.0.1:8000
# JWT_EXPIRE_HOURS=72
