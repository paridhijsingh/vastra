# Copy to .env and fill in. Never commit the real .env.
#
# Required for the backend to start:
#   SECRET_KEY — long random string used to sign JWT access tokens
#   DATABASE_URL — SQLite URL (parent directory is created automatically)

# Generate your own local secret, e.g. python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
DATABASE_URL=sqlite:///./data/vastra.db

# Optional JWT settings (defaults shown).
# JWT_EXPIRE_HOURS=72
# JWT_ALGORITHM=HS256

# Optional Nebius / Nemotron settings. The API starts without a key.
# scripts/check_nemotron.py makes one paid call and requires NEBIUS_API_KEY.
# Docs:
#   API intro: https://docs.tokenfactory.nebius.com/api-reference/introduction
#   Model catalog: https://tokenfactory.nebius.com/model-catalog.md
#   Get a key: https://tokenfactory.nebius.com/ (API keys section)

NEBIUS_API_KEY=your-key-here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEMOTRON_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Stylist chat only. Emergency Fit and Rescue keep NEMOTRON_MODEL.
# Five Nebius calls with thinking disabled returned reasoning_tokens 0 for this model.
# That observation does not establish the control on every Nebius endpoint.
STYLIST_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_TIMEOUT_SECONDS=60
# Trend Stylist. Server-side only. Never copy this into frontend env files.
# Free key: https://app.tavily.com (starts with tvly-). Leave empty until you have one.
TAVILY_API_KEY=
# TREND_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Optional API bind + Streamlit client target (defaults shown).
# API_HOST=127.0.0.1
# API_PORT=8000
# VASTRA_API_URL=http://127.0.0.1:8000

# Optional judge demo account. Never commit real values.
# DEMO_EMAIL is stored as the demo username (Vastra accounts are usernames).
# python scripts/seed_demo.py
# DEMO_EMAIL=demo@vastra.example
# DEMO_PASSWORD=
